# Haven 后端环境变量示例。
#
# 安装时复制到 /etc/haven/haven.env，权限建议 0600（含数据库密码）：
#   install -d -m 0750 /etc/haven
#   install -m 0600 deploy/haven.env.example /etc/haven/haven.env
#   $EDITOR /etc/haven/haven.env
#
# 变量清单与默认值以 docs/architecture.md 第四节为准。
# cookie 名、有效期、bcrypt cost 是代码常量，不在这里配置。

# 监听地址（必填）。只监听本机时用 127.0.0.1，由反向代理对外。
HAVEN_LISTEN_ADDR=127.0.0.1:8080

# PostgreSQL 连接串（必填）
HAVEN_DB_DSN=postgres://haven:CHANGE_ME@127.0.0.1:5432/haven?sslmode=disable

# 前端静态文件目录（必填），即 frontend/dist 的部署位置
HAVEN_FRONTEND_DIR=/opt/haven/frontend/dist

# Gogs 站点 base URL（必填），用于拼作品集链接
HAVEN_GOGS_BASE_URL=https://gogs.example.com

# 会话 cookie 的 Domain（必填）。必须与浏览器访问的域名一致。
#   本地 HTTP 测试：localhost
#   正式域名：app.example.com
HAVEN_COOKIE_DOMAIN=localhost

# 会话 cookie 是否加 Secure（可选，默认 true）。
# 只有纯 HTTP 部署时才设 false；上 HTTPS 后必须保持默认 true。
HAVEN_COOKIE_SECURE=false

# TOTP 验证器里显示的发行者名（可选，默认 Haven）
HAVEN_TOTP_ISSUER=Haven

# 日志级别（可选，默认 info）：debug / info / warn / error
HAVEN_LOG_LEVEL=info

# 上传文件目录（可选，默认 ./uploads）。图片存这里，数据库只存路径。
# systemd 的 ProtectSystem=strict 只允许写 ReadWritePaths 里的目录，改这里要同步改 haven.service。
HAVEN_UPLOAD_DIR=/opt/haven/uploads
